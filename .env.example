# Copy to .env (or run scripts/gen-env.sh, which fills in random secrets).
# Never commit .env.

# Database password. Use URL-safe characters only (it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me

# Signs session tokens. 32+ random characters: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# true when served over HTTPS. Set false only for plain-http local use.
COOKIE_SECURE=false

# Host binding. 127.0.0.1 = this machine only. Use 0.0.0.0 only behind a TLS proxy/firewall.
BIND_ADDRESS=127.0.0.1
PORT=8090

# Optional
ACCESS_TOKEN_MINUTES=60
ENABLE_DOCS=false
